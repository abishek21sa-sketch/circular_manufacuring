# Optional. Defaults to artifacts/platform/circular_v1.sqlite3
CIRCULAR_PLATFORM_DB=

# Local default is 127.0.0.1. Hosted services should use 0.0.0.0.
HOST=127.0.0.1
PORT=8765

# Local academic/research profile. Set to gurobi on the Windows machine with
# the user's Academic Gurobi license. Use auto or scipy only for a portable
# environment without the licensed solver.
CIRCULAR_SOLVER_BACKEND=gurobi

# Deployment boundary. Keep local Studio loopback-only with auth disabled.
# Non-loopback and production binds fail closed unless bearer mode is configured.
CIRCULAR_DEPLOYMENT_MODE=local
CIRCULAR_AUTH_MODE=disabled
# SHA-256 of the bearer token; store the real value in a secret manager.
CIRCULAR_API_TOKEN_SHA256=
# Role attached to the configured token: viewer, operator, or admin.
CIRCULAR_API_ROLE=operator

# Production preflight declarations (never place credentials in this file).
CIRCULAR_PLATFORM_DB_BACKEND=sqlite
CIRCULAR_DATABASE_URL=
# The Windows acceptance lock includes psycopg 3.3.5; a live URL is still required.
CIRCULAR_DATABASE_MIGRATION_STATUS=
CIRCULAR_DATABASE_BACKUP_STATUS=
CIRCULAR_DATABASE_CONCURRENCY_STATUS=
# Run scripts/postgres_operational_check.py against a managed database before
# setting the production database evidence declaration to approved.
CIRCULAR_PRODUCTION_ATTESTATION=
CIRCULAR_GUROBI_LICENSE_CLASS=
CIRCULAR_DATA_VALIDATION_STATUS=

# No API key is required for deterministic V1 operation.
# External LLM explanation layers are intentionally not required by V1.
